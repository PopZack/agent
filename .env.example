# ── 应用 ─────────────────────────────────────────────
APP_NAME=Enterprise Agent
APP_VERSION=0.1.0

# ── 日志 ─────────────────────────────────────────────
# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
# true = 输出 JSON 单行日志（生产/被采集时用）；false = 人类可读
LOG_JSON=false

# ── 模型（阶段 02 才会真正用到，这里先把键名对齐）────────
# 指向你的模型服务，OpenAI 兼容协议；路径要写到 /v1
# 想用本地模拟服务练手：LLM_BASE_URL=http://127.0.0.1:8200/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0.0

# 超时与重试（模型 API 超时/429 是常态，不是异常）
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_SECONDS=0.5
LLM_RETRY_MAX_SECONDS=8
