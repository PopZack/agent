# ─────────────────────────────────────────────────────────────
# AegisFlow 环境变量示例
# 复制为 .env 后按需修改；真正的 .env 不应提交到仓库。
# ─────────────────────────────────────────────────────────────

# ── 应用 ─────────────────────────────────────────────
APP_NAME=AegisFlow
APP_VERSION=0.1.0
# local / test / ci
ENVIRONMENT=local

# ── 日志 ─────────────────────────────────────────────
LOG_LEVEL=INFO
# true = JSON 单行日志（被采集时用）；false = 人类可读
LOG_JSON=false

# ── 运行模式 ─────────────────────────────────────────
# real = 调用真实模型；mock = 确定性模拟（无 API Key 也能跑通闭环）
# 界面与日志必须如实标记当前模式，Mock 模式不得伪装成真实模型结果。
RUN_MODE=mock

# ── 数据库（MySQL 8，阶段 1）─────────────────────────
# docker compose up -d 后使用下面默认值即可
DATABASE_URL=mysql+aiomysql://aegis:aegis@127.0.0.1:3306/aegisflow
DATABASE_ECHO=false

# ── 模型（阶段 4，OpenAI 兼容协议；仅 RUN_MODE=real 时使用）──
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3

# ── Harness 预算与超时（阶段 2/6）────────────────────
MAX_MODEL_CALLS=20
MAX_TOOL_CALLS=30
MAX_INVESTIGATION_ROUNDS=5
TOOL_TIMEOUT_SECONDS=10
MAX_RUN_SECONDS=300
# 估算的模型费用上限（美元），超预算返回 BUDGET_EXCEEDED
MAX_MODEL_COST_USD=0.5

# ── 数据与知识目录（相对仓库根，一般无需修改）────────
DATA_DIR=data
